{
  "manifest_version": 3,
  "name": "KP Brzi Odgovori",
  "version": "1.1",
  "description": "Šablonski odgovori za poruke na KupujemProdajem i Kupindo, ubacuju se jednim klikom.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Brzi odgovori"
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.kupujemprodajem.com/*",
        "https://kupujemprodajem.com/*",
        "https://www.kupindo.com/*",
        "https://kupindo.com/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}